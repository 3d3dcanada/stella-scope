{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella Scope",
  "version": "0.6.1",
  "identifier": "ca.threedthreed.stellascope",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stella Scope",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Watch, control and record your 3D printers: one or a whole farm",
    "longDescription": "Stella Scope records your printers (Klipper, Prusa and FlashForge), shows them live in 3D, runs a farm wall with a job queue, spools and alerts, pairs your phone with one scan so you can watch from anywhere, and warns you when a print fails.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/stella-scope",
      "binaries/stella-link"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "resources": {
      "models/": "models/"
    }
  }
}
