{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella",
  "version": "0.6.0",
  "identifier": "ca.threedthreed.stella",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stella",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "versionCode": 6100
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "stella"
          ],
          "appLink": false
        }
      ]
    }
  }
}
